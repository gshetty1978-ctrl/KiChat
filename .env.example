# Postgres connection string (Render Postgres, Neon, Supabase, or local)
DATABASE_URL=postgres://user:password@localhost:5432/kichat

# Secret used to sign login tokens - set this to a long random string in production
JWT_SECRET=change-this-to-a-long-random-string

# Port the server listens on (Render sets this automatically)
PORT=3000

# Supabase Storage for message photos and profile pictures (optional —
# without these, images are stored inline in Postgres instead, same as
# before Supabase support existed)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=change-this-to-your-service-role-key
SUPABASE_BUCKET=k1chat-media
